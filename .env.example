# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# PostgreSQL
POSTGRES_USER=medrag
POSTGRES_PASSWORD=medrag
POSTGRES_DB=medrag
DATABASE_URL=postgresql://medrag:medrag@localhost:5432/medrag

# Elasticsearch / Milvus
ES_URL=http://localhost:9200
ES_INDEX=medical_chunks
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=medical_chunks

# Embedding (chạy local)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Nơi lưu mô hình tải từ Hugging Face (để trống = mặc định ~/.cache/huggingface)
# Không tự tải thêm bản safetensors (bge-m3 dùng pytorch_model.bin; bản kia trùng 2,3 GB)
DISABLE_SAFETENSORS_CONVERSION=true
HF_HOME=

# LLM (API miễn phí) — nhà cung cấp mặc định: groq (Qwen) | cloudflare (Llama 3) | gemini (thay GPT-4o)
LLM_PROVIDER=groq
LLM_MODEL=
# GĐ 7: LLM chưa trả lời sau N giây thì gửi thêm 1 yêu cầu giống hệt, lấy kết quả về trước (0 = tắt)
LLM_HEDGE_AFTER_S=8
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Dịch câu hỏi sang tiếng Anh cho BM25 (tài liệu WHO/MedlinePlus là tiếng Anh)
TRANSLATE_QUERY=true
OLLAMA_URL=http://localhost:11434

# Frontend được phép gọi API (CORS), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Tài khoản (GĐ 8)
# Chuỗi bí mật ký token đăng nhập – tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
# Google OAuth Client ID (Google Cloud Console → Clients → Web application); trống = ẩn nút Google
GOOGLE_CLIENT_ID=
# Email có vai trò quản trị, phân tách bằng dấu phẩy
ADMIN_EMAILS=
